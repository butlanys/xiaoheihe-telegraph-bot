# ===== Telegram =====
# @BotFather 创建机器人后获取
BOT_TOKEN=

# ===== 小黑盒认证 =====
# 浏览器/APP 请求小黑盒 API 时 Cookie 里的 x_xhh_tokenid 值
# 带上后可显著降低 show_captcha 限频（IP 级限频主要针对未认证请求）
XHH_TOKEN=

# ===== Telegraph =====
# 获取方式：
#   curl -s 'https://api.telegra.ph/createAccount?short_name=xhh&author_name=xhh'
#   返回的 result.access_token
TELEGRAPH_TOKEN=

# ===== 网络 =====
# warp   = 只走 WARP SOCKS5
# direct = 直连（配合 XHH_TOKEN 使用，推荐）
# auto   = 先 WARP，失败/限频自动切直连
PROXY_MODE=direct
WARP_PROXY=socks5://127.0.0.1:40000

# ===== 其它 =====
TZ=Asia/Shanghai
# DEBUG=1 输出调试日志
DEBUG=0
